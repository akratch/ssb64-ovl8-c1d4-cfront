#!/usr/bin/env python3

"""Prototype cfront-to-IDO7.1-C wrapper; see README before upstream use."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import tempfile


def fail(message: str) -> None:
    print(f"cc-cfront: {message}", file=sys.stderr)
    raise SystemExit(2)


def split_arguments(arguments: list[str]) -> tuple[Path, Path, list[str]]:
    args = arguments.copy()
    output: Path | None = None

    index = 0
    while index < len(args):
        if args[index] == "-o":
            if index + 1 == len(args):
                fail("missing argument after -o")
            output = Path(args[index + 1])
            del args[index : index + 2]
            continue
        index += 1

    if output is None:
        fail("an output path must be supplied with -o")
    if not args or args[-1].startswith("-"):
        fail("the input source must be the final argument")

    source = Path(args.pop())
    return source, output, args


def preprocessor_arguments(driver_args: list[str]) -> list[str]:
    result = [
        "-+",
        "-D__cplusplus=1",
        "-D_LANGUAGE_C_PLUS_PLUS",
        "-DLANGUAGE_C_PLUS_PLUS",
    ]

    index = 0
    while index < len(driver_args):
        arg = driver_args[index]
        if arg in {"-D", "-U", "-I"}:
            if index + 1 == len(driver_args):
                fail(f"missing argument after {arg}")
            result.extend((arg, driver_args[index + 1]))
            index += 2
            continue
        if arg.startswith(("-D", "-U", "-I")) and len(arg) > 2:
            result.append(arg)
        index += 1

    return result


def run(
    command: list[str],
    *,
    stdin: object | None = None,
    stdout: object | None = None,
    env: dict[str, str] | None = None,
) -> None:
    subprocess.run(
        command,
        stdin=stdin,
        stdout=stdout,
        env=env,
        check=True,
    )


def main() -> None:
    source, output, driver_args = split_arguments(sys.argv[1:])
    compiler_dir = Path(__file__).resolve().parent
    irix_root = compiler_dir / "irix"

    acpp = compiler_dir / "acpp"
    cfront = irix_root / "usr/lib/c++/cfront"
    qemu_irix = compiler_dir / "qemu-irix"
    cc = compiler_dir / "cc"

    for tool in (acpp, cfront, qemu_irix, cc):
        if not tool.is_file():
            fail(f"missing compiler component: {tool}")

    with tempfile.TemporaryDirectory(prefix="ido71-cfront-") as temp_name:
        temp_dir = Path(temp_name)
        preprocessed = temp_dir / "input.i"
        translated = temp_dir / "translated.c"

        with preprocessed.open("wb") as output_file:
            run(
                [str(acpp), *preprocessor_arguments(driver_args), str(source)],
                stdout=output_file,
            )

        with preprocessed.open("rb") as input_file, translated.open("wb") as output_file:
            run(
                [
                    str(qemu_irix),
                    "-silent",
                    "-L",
                    str(irix_root),
                    str(cfront),
                    f"+f{source.name}",
                ],
                stdin=input_file,
                stdout=output_file,
            )

        compiler_env = os.environ.copy()
        compiler_env["USR_LIB"] = str(compiler_dir)
        run(
            [str(cc), *driver_args, "-o", str(output), str(translated)],
            env=compiler_env,
        )


if __name__ == "__main__":
    main()
