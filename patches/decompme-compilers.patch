+# NOTE: This file is generated automatically via template.py. Do not edit manually!
+
+
+FROM gcc:14 AS base
+
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends ca-certificates curl ncompress wget xz-utils \
+    && rm -rf /var/lib/apt/lists/*
+
+WORKDIR /tmp/build
+
+RUN wget -O ido71.tar.gz "https://github.com/decompals/ido-static-recomp/releases/download/v1.2/ido-7.1-recomp-linux.tar.gz" \
+    && mkdir ido71 \
+    && tar xzf ido71.tar.gz -C ido71
+
+RUN mkdir dist \
+    && curl --fail --location --retry 3 \
+        --range "125260288-125423674" \
+        --output dist/c++_dev.idb "https://jrra.zone/sgi/tar/MIPSpro%20C%2b%2b%207.1.tar" \
+    && echo "84bba65ed2165ef335b09024b28c80fb5601e54c37255e7cf556c48f99564623  dist/c++_dev.idb" | sha256sum -c - \
+    && curl --fail --location --retry 3 \
+        --range "126331392-135482843" \
+        --output dist/c++_dev.sw "https://jrra.zone/sgi/tar/MIPSpro%20C%2b%2b%207.1.tar" \
+    && echo "878e6bef1d45a67a9c5aa4e14c7433e2e7dbe01de3f5cef92ebc44c9b9da3531  dist/c++_dev.sw" | sha256sum -c -
+
+RUN wget -O irixswextract.c "https://gist.githubusercontent.com/camthesaxman/dcc60d98f152b4fed32dfc18d7246551/raw/dda1b80bfe90f93d5de23936b92caf2ca41a53db/irixswextract.c" \
+    && echo "514f4f73bcd74d8a739674eabd2b637e0052a57611f3c4c9755703756ba05d58  irixswextract.c" | sha256sum -c - \
+    && cc -O2 -Wall -Wextra irixswextract.c -o irixswextract \
+    && grep ' usr/lib/c++/cfront ' dist/c++_dev.idb > cfront.idb \
+    && mkdir cxx71 \
+    && ./irixswextract dist cfront.idb cxx71
+
+RUN wget -O mipspro744.tar.xz "https://github.com/LLONSIT/qemu-irix-helpers/raw/n/qemu/mipspro7.4.4.tar.xz" \
+    && echo "df33be0d9605b00b44070e567121fc00283a9b1f97763403f0898d2216028d24  mipspro744.tar.xz" | sha256sum -c - \
+    && mkdir runtime \
+    && tar xJf mipspro744.tar.xz -C runtime \
+        lib/rld lib/libc.so.1 lib/libmalloc.so \
+        usr/bin/qemu-irix usr/lib/libc.so.1
+
+RUN wget -O ido60.tar.xz "https://github.com/LLONSIT/qemu-irix-helpers/raw/n/qemu/ido6.0.tar.xz" \
+    && echo "c56d4be020bdaf76310ceec455ebc0d443fb7a46c740491f74898b04f6a60356  ido60.tar.xz" | sha256sum -c - \
+    && tar xJf ido60.tar.xz -C runtime usr/lib/libC.so
+
+RUN mkdir -p \
+        /compilers/n64/ido7.1_cfront/irix/usr/lib/c++ \
+        /compilers/n64/ido7.1_cfront/irix/usr/lib \
+        /compilers/n64/ido7.1_cfront/irix/lib \
+        /compilers/n64/ido7.1_cfront/irix/usr/tmp \
+    && cp -a ido71/. /compilers/n64/ido7.1_cfront/ \
+    && cp cxx71/usr/lib/c++/cfront \
+        /compilers/n64/ido7.1_cfront/irix/usr/lib/c++/cfront \
+    && cp runtime/usr/bin/qemu-irix \
+        /compilers/n64/ido7.1_cfront/qemu-irix \
+    && cp runtime/usr/lib/libC.so runtime/usr/lib/libc.so.1 \
+        /compilers/n64/ido7.1_cfront/irix/usr/lib/ \
+    && cp runtime/lib/rld runtime/lib/libc.so.1 runtime/lib/libmalloc.so \
+        /compilers/n64/ido7.1_cfront/irix/lib/
+
+COPY scripts/cc-cfront /compilers/n64/ido7.1_cfront/cc-cfront
+
+RUN chown -R root:root /compilers/n64/ido7.1_cfront \
+    && chmod +x \
+        /compilers/n64/ido7.1_cfront/cc-cfront \
+        /compilers/n64/ido7.1_cfront/qemu-irix \
+        /compilers/n64/ido7.1_cfront/irix/usr/lib/c++/cfront
+
+FROM scratch AS release
+
+COPY --from=base /compilers /compilers
diff --git a/scripts/cc-cfront b/scripts/cc-cfront
